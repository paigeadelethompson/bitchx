^set input_prompt $(sc2)\($(sc1)$C$(sc2)) 

alias stat10 {
^set status_oper $(hblk)*
^fset format_status $0-
^fset format_status1 $0-
^fset format_status2 $0-
^fset format_status3 $0-
^set status_clock %T
^set status_format1 $(sc1)Ã$(sc2)Ä$(sc1)´ %*%=%@$(cl)%N $(hwht)%# %C %+ %! $(hblk)\($(sc1)lag$(hblk)/$(hwht)%L$(hblk)) %> $(sc1)Ã$(sc2)Ä$(sc1)´
^set status_format2 $(sc2)À$(sc1)Ä$(sc2)Ù %S%6 $(sc1)time$(hblk)/$(sc1)%T %Q %B %> $(hblk)\($(sc1)win$(hblk)/$(hwht)%R$(hblk)) %F %A %5 $(sc2)À$(sc1)Ä$(sc2)Ù
^set status_umode $(hblk)\($(cl)+$(hwht)%#$(hblk))
^set status_users $(hblk)\($(sc1)o$(hblk)/$(hwht)%! $(sc1)n$(hblk)/$(hwht)%! $(sc1)i$(hblk)/$(hwht)%! $(sc1)v$(hblk)/$(cl)%!$(hblk))
^set status_nick $(sc1)%N
^set status_lag %L
^set status_channel $(sc1)%C
^set status_mode $(hblk)\($(cl)+$(hwht)%+$(hblk))  
^set status_chanop $(sc2)@
^set status_mail $(hblk) $(hwht)m$(cl)ai$(hblk)l $(hwht)%M
^set status_server $(sc1)s$(hblk)/$(sc1)%S
^set status_voice +
^set status_away  $(hblk)[$(sc1)away %A$(hblk)]
^set status_notify $(hblk)\($(sc1)act$(hwht)%F$(hblk))
^set status_hold_lines $(hblk)\[$(hwht)%B$(hblk)]
^set status_query $(hblk)\[$(blu)Q$(wht): $(wht)%Q$(hblk)]
^set status_format3 $(cl)$(hblk)\[$(sc1)t:$(hblk)­$(hblu)%C$(hblk)]$(cl) %- %>
}
alias wsetupdate {
^wset * status_format $status_format
^wset * status_format1 $status_format1
^wset * status_umode $status_umode
^wset * status_format2 $status_format2
^wset * status_lag $status_lag
^wset * status_channel $status_channel
^wset * status_mode $status_mode
^wset * status_chanop $status_chanop
^wset * status_mail $status_mail
^wset * status_users $status_users
^wset * status_server $status_server
^wset * status_voice $status_voice
^wset * status_away $status_away 
^wset * status_notify $status_notify
^wset * input_prompt $input_prompt
^wset * status_hold_lines $status_hold_lines
^wset * status_query $status_query
^wset * status_format3 $status_format3
^wset * status_clock $status_clock
^wset * status_nick $status_nick
}
^set status_does_expandos OFF
stat10
wsetupdate
^window triple off
dotopwin