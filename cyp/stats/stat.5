^set STATUS_CHANNEL $(cl)%C$(cl)
^set STATUS_USERS $(hblk)[$(cl)o$(sc1).$(hwht)%! $(cl)n$(sc1).$(hwht)%! $(cl)i$(sc1).$(hwht)%! $(cl)v$(sc1).$(hwht)%!$(hblk)]$(cl)
