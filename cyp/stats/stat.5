^set STATUS_SERVER $(sc1)%S$(cl)
^set STATUS_QUERY  $(hblk)<$(cl)q$(sc1).$(hwht)%Q$(hblk)>$(cl)
^set STATUS_OPER $(hblk)*$(cl)
^set STATUS_NICK $(cl)%N$(cl)
^set STATUS_MODE $(hblk)\($(hwht)+$(cl)%+$(hblk)\)$(cl)
^set STATUS_UMODE $(hblk)\($(hwht)+$(cl)%#$(hblk)\)$(cl)
^set STATUS_LAG $(hwht)%L$(cl)
^set STATUS_FORMAT3 $(sc1).$(hblk).[$(cl)t$(sc1).$(hwht)%C$(hblk)]$(cl) %- %>
^set STATUS_FORMAT $(sc1)Ú$(hblk)Ä$(sc1)Â $(cl)%=%*%@%N%#$(sc1).%C%+ %! %> $(hwht)l$(cl)ag$(hblk)\($(cl)%L$(hblk)\)$(cl)%A $(hblk)Â$(sc1)Ä$(hblk)¿$(cl)
^set STATUS_FORMAT1 $(sc1)Ú$(hblk)Ä$(sc1)Â$(cl) %=%*%@$(cl)%N%#$(sc1).%C%+ %! %> $(hwht)l$(cl)ag$(hblk)\($(cl)%L$(hblk)\)$(cl)%A $(hblk)Â$(sc1)Ä$(hblk)¿$(cl)
^set STATUS_FORMAT2 $(hblk)À$(sc1)Ä$(hblk)Á$(cl) $(hwht)s$(cl)erv$(hblk)\($(cl)%S$(hblk)\)$(cl)%Q %> %1 $(hblk)\($(hwht)w$(cl)in$(sc1).$(hwht)%R$(hblk)\)$(cl) $(hblk)\($(hwht)t$(cl)ime$(sc1).$(hwht)%T$(hblk)\) $(sc1)Á$(hblk)Ä$(sc1)Ù$(cl)
^set STATUS_CHANOP $(sc1)@$(cl)
^set STATUS_AWAY  $(hblk)<$(hwht)a$(cl)way$(hblk)>$(cl)

}

