^set status_format1 $(hblk)Ú$(sc2)Ä$(sc1)\( %*%=%@$(hwht)%N $(hwht)%# %C %+ %! $(hblk)\($(cl)lag$(sc1)/$(cl)%L$(hblk))%F %> $(sc1))$(sc2)Ä$(hblk)¿
