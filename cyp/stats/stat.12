## design from evolver, sorta...
## cl

alias stat12 {
^set status_format1   $(hblk)<д$(sc1)д$(sc2)д$(sc1)д$(hblk)©$(cl)   %@%*%=%N$(hblk)\($(cl)%#$(hblk)\)$(sc2) Ы %C$(hblk)\($(cl)%+$(hblk)\)$(cl) $(sc2)Ы$(cl) %! %>
^set status_format2   $(hblk)з$(sc1)д$(sc2)д$(sc1)д$(hblk)д$(sc1)е$(sc2)д$(hblk)>$(cl) %S $(sc2)Ы$(hblk) \($(sc2)l$(sc1)ag$(hblk)/$(sc1)%L$(hblk)\) \($(sc2)t$(sc1)ime$(hblk)/$(sc1)%T$(hblk)\) $(sc2)Ы $(hblk)\($(sc2)w$(sc1)in$(hblk)/$(sc1)%R$(hblk)\)$(cl) $(hblk)[$(sc1)%u$(hblk):$(sc1)%a$(hblk):$(sc1)%f$(hblk):$(sc1)%b$(hblk):$(sc1)%h$(hblk)]$(cl) %>
^set status_format3 $(hblk)<$(sc1)де$(sc2)д$(sc1)д$(hblk)д$(sc1)д$(sc2)ы$(cl)   %K%& %M %A %F$(sc2)Ы$(cl)  %Q %>
^set input_prompt   $(hblk)юд$(sc1)д$(sc2)д$(sc1)д$(hblk)>$(cl) 
^set status_chanop $(sc2)@$(cl)
^set status_oper $(hwht)*$(cl)
^set status_voice $(sc1)+$(cl)
^set status_nick $(sc1)%N
^set status_umode $(sc2)+$(sc1)%#$(cl)
^set status_channel $(sc1)%C$(cl)
^set status_mode $(sc2)+$(sc1)%+$(cl)
^set status_users $(hblk)\($(sc2)o$(hblk)/$(sc1)%! $(sc2)n$(hblk)/$(sc1)%! $(sc2)i$(hblk)/$(sc1)%! $(sc2)v$(hblk)/$(sc1)%!$(hblk)\)$(cl)
^set status_server $(sc1)%S$(cl)
^set status_lag $(sc1)%L$(cl)
^set status_away $(hblk)[$(sc2)a$(sc1)way $(sc2)%A$(hblk)]$(cl) 
^set status_query $(hblk)[$(sc2)q$(sc1)uery$(sc2) %Q$(hblk)]$(cl)
^set status_clock $(sc1)%T$(cl)
^set status_notify $(hblk)\($(sc2)a$(sc1)ct$(hblk)/$(sc1)%F$(hblk)\)$(cl)
^set status_dcccount  $(hblk)[$(sc2)d$(sc1)cc$(hblk)/$(sc2)g$(sc1)ets$(hblk):$(sc1) %& $(sc2)s$(sc1)ends$(hblk):$(sc1) %&$(hblk)]$(cl)
^set status_mail $(hblk)\($(sc2)m$(sc1)ail$(sc2) %M$(hblk)\)$(cl)
^set status_oper_kills $(hblk)[$(sc2)n$(sc1)k$(hblk)/$(sc1)%K $(sc2)o$(sc1)k$(hblk)/$(sc1)%K$(hblk)]$(cl)
}

alias wsetupdate {
^wset * status_format1 $status_format1
^wset * status_format2 $status_format2
^wset * status_format3 $status_format3
^wset * status_chanop $status_chanop
^wset * status_oper $status_oper
^wset * status_voice $status_voice
^wset * status_nick $status_nick
^wset * status_umode $status_umode
^wset * status_channel $status_channel
^wset * status_mode $status_mode
^wset * status_users $status_users
^wset * status_server $status_server
^wset * status_lag $status_lag
^wset * status_away $status_away
^wset * status_query $status_query
^wset * status_clock $status_clock
^wset * status_notify $status_notify
^wset * status_dcccount $status_dcccount
^wset * status_mail $status_mail
^set status_does_expandos ON
^window split off
^window triple on
}
stat12
wsetupdate


^set status_does_expandos OFF
^window triple off
dotopwin