^set input_prompt $(mag).$(sc1).$(hblk)\($(sc1)$C$(hblk)\)$(cl) 
alias stat6 {
^set STATUS_AWAY $(sc1)zZzZ$(mag) +$(cl)
^set STATUS_CHANNEL $(mag)/$(sc1)%C$(cl)
^set STATUS_CHANOP $(sc2)@$(cl)
^set STATUS_CLOCK $(sc1)%T$(cl)
^set STATUS_CPU_SAVER  (%L)
^set STATUS_DOES_EXPANDOS is ON
^set STATUS_FORMAT %T [%R] %*%=%@%N%#%S%H%B%Q%A%C%+%I%O%M%F%L %D %U %W
^set STATUS_FORMAT1 $(hwht)<ÄÄ$(cl)ÄÄ$(hblk)¿ %=%*%@$(sc1)%N$(cl)%#%C%+ %>%! $(mag)+$(sc2) w$(sc1)in$(hblk):$(sc1) %R $(hwht)<ÄÄ$(cl)ÄÄ$(hblk)¿$(cl)
^set STATUS_FORMAT2 $(hblk)À$(cl)ÄÄ$(hwht)ÄÄ>$(sc1) %T $(mag)+$(sc2) $(sc2)s$(sc1)erv$(hblk):$(sc1) %S%>  $(hblk)\($(sc2)a$(sc1)ct$(mag): $(sc1)%F$(hblk)) $(mag)+$(sc2) %A $(sc2)l$(sc1)ag$(hblk):$(sc1)%L$(hblk) À$(cl)ÄÄ$(hwht)ÄÄ>$(cl)
^set STATUS_MODE $(hblk)\($(cl)+$(sc1)%+$(hblk)\)$(cl)
^set STATUS_NICK %N
^set STATUS_NOTIFY %F
^set STATUS_OPER $(hblk)*
^set STATUS_SERVER %S
^set STATUS_UMODE $(hblk)\($(cl)+$(sc1)%#$(hblk)\)$(cl)
^set STATUS_VOICE $(mag)+$(cl)
^set status_lag $(sc1)%L$(cl)
^set status_users $(hblk)\($(cl)o$(mag)/$(sc1)%! $(cl)n$(mag)/$(sc1)%! $(cl)i$(mag)/$(sc1)%! $(cl)v$(mag)/$(sc1)%!$(hblk)\)$(cl)
^set status_format3 $(sc1).$(hblk).\($(cl)t$(sc1)%C$(hblk)\)$(cl) %- %>

}

alias wsetupdate {
^wset * status_format $status_format
^wset * status_format1 $status_format1
^wset * status_umode $status_umode
^wset * status_format2 $status_format2
^wset * status_lag $status_lag
^wset * status_channel $status_channel
^wset * status_mode $status_mode
^wset * status_chanop $status_chanop
^wset * status_format3 $status_format3
^wset * status_mail $status_mail
^wset * status_users $status_users
^wset * status_server $status_server
^wset * status_voice $status_voice
^wset * status_away $status_away
^wset * status_notify $status_notify
^wset * input_prompt $input_prompt
^wset * status_hold_lines $status_hold_lines
^wset * status_query $status_query
^wset * status_format3 $status_format3
^wset * status_dcccount $status_dcccount
^wset * status_clock $status_clock
^wset * status_nick $status_nick
}
stat6
wsetupdate
^set status_does_expandos OFF
^window triple off
dotopwin