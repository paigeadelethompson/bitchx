^randcl
@ adf = 0
^do.formatupdate
fset -format_away
fset -format_back
alias quit {
	if ([$0]) { 	
		if (_quittog==[on]) {
		eval //quit BitchX: $$quitlogo $*
		}{
		eval //quit $*
		echo test
		}
	}{
		if (_quittog==[on]) {
		eval //quit $$quitlogo $getreason($N BitchX.quit)
		}{
		eval //quit $getreason($N BitchX.quit) 
		}

	}
}

^set CDCC_PROMPT $(c4)C$(c3)DCC
^set SERVER_PROMPT $(hblk)[$(c3)$0$(hblk)] 
