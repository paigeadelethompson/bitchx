::minor alias's

alias aop {if ([$*]) {
	fe ($mychannels()) chan {
		if (ischanop($N $chan) && onchannel($0 $chan) && !ischanop($0 $chan)) {
			mode $chan o $0}
				}} {xecho -b -l crap usage: /aop <nick>;xecho -b -l crap description: ops a user on all your common channels}
}



## because I love power 
alias cops {
	^on who -*
		^on ^who * {
			if ([$[2]2]==[G*] ^^ [$[2]2]==[H*]) {
				xecho -w $winchan $cparse($(c1) $[9]0) $cparse($(c2) $[9]1) $cparse($(c1) $[20]5) $(cl)$3$cparse($(c1)@)$(cl)$4  
			}
		}
			who $C
				wait 
				^on who -*
					^on ^who * {
						xecho -w $winchan $cparse($(c1) $[9]0) $cparse($(c2) $[9]1) $cparse($(c1) $[20]5) $(cl)$3$cparse($(c1)@)$(cl)$4  
					}
}

alias _center {
@ number = (word(0 $geom()) - printlen($stripansicodes($1-))) / 2
xecho -w $0 $repeat($number  )$1-
}
alias n names $C
alias cfparse {eval return $(cparse("$($0))")}
alias bankick bk
alias v voice
alias rn randnick
alias csc clear;sc
alias cig ignore $C all
alias not untopic
alias 4v mode $C +vvvv $0 $0 $0 $0
alias mreop {
op $chops()
}
alias fctcp if (![$0]) {
	xecho -b usage: /fctcp nick/channel <arguements>
	}{
	notice $0 $chr(1)$1-$chr(1)
}

alias sync {
        @ :cmodes=M
        /c +m - $cmodes;/c -m + $cmodes}
alias oecho echo $cparse("$*")
alias owecho xecho -w $winnum() $cparse("$*")
alias obecho xecho -b $cparse("$*")

