$G $(c2)DCC$(cl) GET $(cl)connection with $(hwht)void^$(hblk)[$(c2)hellfire.liii.com, port 1280$(hblk)]$(cl) established

$G $Cparse(%K[%n5%K]%n)
$G $(hblk)\($(c2)dcc$(hblk)!$(hwht)codelogic$(hblk)\) $(cl)will you phear me?
$G $(c2)DCC$(cl) GET $(cl)connection with $(hwht)void^$(hblk)\($(c2)hellfire.liii.com, port 1280$(hblk))$(cl) established

$G $Cparse(%K[%n6%K]%n)
$G $(cl)dcc$(hblk)!$(hwht)codelogic $(hblk)­ $(cl)will you phear me?
