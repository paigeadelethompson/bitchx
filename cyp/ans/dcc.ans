$scriptname usage: /format r <num>

$G $Cparse(%K[%n1%K]%n)
$(hblk).$(cyn).$(hblk)[$(cl)codelogic$(hblk)\($(hwht)d$(cl)cc$(hblk)\)] $(cl)will you phear me?
$G $(hblk).$(cyn).$(hblk)[$(hwht)d$(cl)cc$(hblk)] $(cyn)GET $(cl)connection with $(hcyn)void^$(hblk)[$(cyn)hellfire.liii.com$(hblk):$(cyn)1280$(hblk)]$(cl) established

$G $Cparse(%K[%n2%K]%n)
$G $(hblk).$(c1).$(hblk)[$(c1)codelogic$(hblk)\($(c2)dcc$(hblk)\)] $(cl)will you phear me?
$G $(c1).$(hblk).[$(c2)dcc$(hblk)]$(c1) GET $(cl)connection with $(c1)void^$(hblk)[$(c1)hellfire.liii.com$(c2):$(c1)1280$(hblk)]$(cl) established

$G $Cparse(%K[%n3%K]%n)
