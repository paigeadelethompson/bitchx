alias sc.doopers {
    ^local line
    ^local ix 0
    xecho -w $_win      $(sc.border.subleft)$pad(${_wid-1}  )$(hwht)o$(cl)pers$(hwht):$(cl) $pad(5 $#*)$pad(${_wid-1}  )$sc.border.subright
    ^assign -line
    fe ($*) foof {
        if (ix == sc.nicksperline)
            {xecho -w $_win      $(sc.border.left) $(line)$(sc.border.right);@ix=0;@line=[]}
        if (left(1 $foof) == [@])
            {@push(line $operoppre$right(10 $[11]foof))}
        if  (left(1 $foof) == [*])
                {@push(line $opervocre$right(10 $[11]foof))}
        if        (left(1 $foof) == [.])
                    {@push(line $opernonpre$right(10 $[11]foof))}
        @ix++
    }
    while (ix < sc.nicksperline)
        {@push(line $pad(11  ));@ix++}
    xecho -w $_win      $(sc.border.left) $(line)$(sc.border.right)
}

