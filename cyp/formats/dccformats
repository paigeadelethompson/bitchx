@maxdccform=7
alias dccformat if ([$0]) {
	if ([$0]<=[$maxdccform]) {do.dccform $0}{xecho -b cypress usage: /format n <1-$maxdccform> current format is $(hwht)$dccform$(cl) }
}
alias do.dccform {
switch ($0) {
	(1) {dccform1;xecho -b dcc format set to $(hwht)$dccform}
	(2) {dccform2;xecho -b dcc format set to $(hwht)$dccform}
	(3) {dccform3;xecho -b dcc format set to $(hwht)$dccform}
	(4) {dccform4;xecho -b dcc format set to $(hwht)$dccform}
	(5) {dccform5;xecho -b dcc format set to $(hwht)$dccform}
	(6) {dccform6;xecho -b dcc format set to $(hwht)$dccform}
	(7) {dccform7;xecho -b dcc format set to $(hwht)$dccform}
	(*) {format r}}
}

alias do.dccload {
switch ($0) {
        (1) {dccform1}
        (2) {dccform2}
        (3) {dccform3}
        (4) {dccform4}
        (5) {dccform5}
	(6) {dccform6}
	(7) {dccform7}
	(*) {format r}}
}

alias dccform1 { 
@ dccform = 1
^fset FORMAT_DCC_CHAT %@%K.%c.%K[%w$$1%K\(%Wd%ncc%K)] %n$$3-
^fset FORMAT_DCC_CONNECT $$G %K.%c.%K[%Wd%ncc%K] %c$$1 %nconnection with %C$$2%K[%c$$4%K:%c$$5%K]%n established
^fset FORMAT_DCC_ERROR $$G %K.%c.%K[%Wd%ncc%K]%c lost %W$$1%n to %W$$2%K [%n$$3-%K]%n
^fset FORMAT_DCC_LOST $$G %@%K.%c.%K[%Wd%ncc%K]%c $$1 %K:%n$$2 %K[%n$$3%K]%n $$4 $$5 completed in $$6 secs %K(%n$7 $8%K/%nsec%K)%n
^fset FORMAT_DCC_REQUEST $$G %@%K.%c.%K[%Wd%ncc%K]%c $$1 %K(%n$2%K)%n request from %W$$3%K[%n$$4 %K(%n$5%K:%n$6%K)]%n $$8 $$7
^fset FORMAT_SEND_DCC_CHAT %K.%c.%K[%Wd%ncc%K\(%n\$1%K)]%n $$2-
}

