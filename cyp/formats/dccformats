^fset FORMAT_DCC_CONNECT $$G $(c1).$(hblk).[$(c2)dcc$(hblk)]$(c1) $$1 $(cl)connection with $(c1)$$2$(hblk)[$(c1)$$4$(c2):$(c1)$$5$(hblk)]$(cl) established
^fset FORMAT_DCC_ERROR $$G $(c1).$(hblk).[$(c2)dcc$(hblk)]$(cl) lost $(c1)$$1$(cl) to $(c1)$$2$(hblk) [$(c2)$$3-$(hblk)]$(cl)
^fset FORMAT_DCC_LOST $$G %@$(c1).$(hblk).[$(c2)dcc$(hblk)]$(c1) $$1 $(c2):$(c1)$$2 $(hblk)[$(c1)$$3$(hblk)]$(c1) $$4 $$5 $(cl)completed in $(c1)$$6$(cl) secs $(hblk)($(c1)$7 $8$(hblk)/$(cl)sec$(hblk))$(cl)
^fset FORMAT_DCC_REQUEST $$G %@$(c1).$(hblk).[$(c2)dcc$(hblk)]$(c1) $$1 $(hblk)($(c1)$2$(hblk))$(cl) request from $(c2)$$3$(hblk)[$(c1)$4$(hblk)($(c1)$5$(c2):$(c1)$6$(hblk))]$(cl) $$8 $$7
^fset FORMAT_SEND_DCC_CHAT $(c1).$(hblk).[$(c2)dcc$(hblk)\($(c1)\$1$(hblk))]$(cl) $$2-
}

